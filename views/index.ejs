                                    </div>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.2rem;">
                                        <span style="color: var(--text-muted); font-size: 0.8rem;">Bot Clicks Blocked</span>
                                        <span style="color: var(--danger); font-weight: 600;"><%= typeof botClicks !== 'undefined' ? botClicks : 0 %></span>
                                    </div>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.2rem;">
                                        <span style="color: var(--text-muted); font-size: 0.8rem;">Real Clicks</span>
                                        <span style="color: var(--success); font-weight: 600;"><%= typeof realClicks !== 'undefined' ? realClicks : 0 %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glass-card" style="margin-bottom: 2rem;">
                    <h3 style="margin-bottom: 0.5rem; font-weight: 700;">🔗 Create New Short Link</h3>
                    <form action="/shorten" method="POST" class="shorten-form">
                        <div class="form-group">
                            <input type="url" class="form-control" name="originalUrl" placeholder="Enter your long URL" required>
                        </div>
                        <div class="form-group" style="min-width: 150px; flex: 0.5;">
                            <input type="text" class="form-control" name="customSlug" placeholder="Custom slug (optional)">
                        </div>
                        <div class="form-group" style="min-width: 120px; flex: 0.3;">
                            <select class="form-control" name="expiresIn">
                                <option value="">Never</option>
                                <option value="1">1 Day</option>
                                <option value="7">7 Days</option>
                                <option value="30">30 Days</option>
                                <option value="90">90 Days</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary">🚀 Shorten</button>
