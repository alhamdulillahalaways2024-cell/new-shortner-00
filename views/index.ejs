                <h2 style="margin-bottom: 1.5rem; font-weight: 700;">My Short Links</h2>

                <% if (typeof links !== 'undefined' && links && links.length > 0) { %>
                    <% links.forEach(function(link) { 
                        var linkUrl = link.shortUrl || '';
                        var linkId = link.id || link._id || '';
                        var linkCode = link.shortCode || '';
                        var linkOriginal = link.originalUrl || '';
                        var linkClicks = link.clicks || 0;
                        var linkCreated = link.createdAt || '';
                        var linkTitle = link.title || '';
                        var isExpired = link.isExpired || false;
                        var isActive = link.isActive !== undefined ? link.isActive : true;
                    %>
                        <div class="link-card">
                            <div class="link-top">
                                <div>
                                    <a href="/<%= linkCode %>" target="_blank" class="link-url">🔗 <%= linkUrl %></a>
                                    <% if (linkTitle) { %><div class="link-title"><%= linkTitle %></div><% } %>
                                    <div class="link-original">→ <%= linkOriginal %></div>
                                </div>
                                <div style="display: flex; gap: 0.3rem; flex-wrap: wrap;">
                                    <button class="btn btn-secondary btn-sm copy-link-btn" data-url="<%= linkUrl %>" style="flex-shrink: 0; cursor: pointer;">📋 Copy</button>
                                    <button class="btn btn-secondary btn-sm" onclick="generateQR('<%= linkCode %>')" style="flex-shrink: 0; cursor: pointer;">📱 QR</button>
                                </div>
                            </div>
                            <div class="link-meta">
                                <span>👁️ <%= linkClicks %> clicks</span>
                                <span>📅 <span class="link-date" data-date="<%= linkCreated %>"><%= linkCreated %></span></span>
                                <span>🆔 <%= linkCode %></span>
                                <% if (isExpired) { %>
                                    <span class="badge badge-expired">⏰ Expired</span>
                                <% } else if (!isActive) { %>
                                    <span class="badge badge-inactive">⛔ Inactive</span>
                                <% } else { %>
                                    <span class="badge badge-active">✅ Active</span>
                                <% } %>
                            </div>
                            <div class="link-actions">
                                <form action="/update-link/<%= linkId %>" method="POST" class="edit-form">
                                    <input type="url" name="newUrl" placeholder="Enter new URL" required>
                                    <div class="edit-actions">
                                        <button type="submit" class="btn btn-warning btn-sm">✏️ Update</button>
                                    </div>
                                </form>
                                <div class="btn-group">
                                    <form action="/toggle-link/<%= linkId %>" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-secondary btn-sm" onclick="return confirm('Toggle this link?')"><%= isActive ? '⏸️' : '▶️' %></button>
                                    </form>
                                    <form action="/delete-link/<%= linkId %>" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this link?')">🗑️ Delete</button>
                                    </form>
