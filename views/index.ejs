                <div class="error-desc">The page you're looking for doesn't exist or has been moved.</div>
                <div style="margin-top: 2rem;">
                    <a href="/" class="btn btn-primary">🏠 Go Home</a>
                    <a href="/dashboard" class="btn btn-secondary">📊 Dashboard</a>
                </div>
            </div>
        <% } %>

    </div>

    <footer class="footer">
        <p>🔗 This Person Is brand Shortlink &bull; <span class="heart">❤️</span> &bull; Powered by <a href="https://t.me/thispersonisbrand537" target="_blank" rel="noopener noreferrer">@thispersonisbrand537</a></p>
        <p style="font-size: 0.75rem; margin-top: 0.5rem; opacity: 0.5;">© 2026 All rights reserved &bull; ♾️ Unlimited Short Links</p>
    </footer>

    <script>
        // ===== DROPDOWN TOGGLE =====
        function toggleDropdown() {
            var menu = document.getElementById('dropdownMenu');
            var chevron = document.getElementById('dropdownChevron');
            if (menu) menu.classList.toggle('open');
            if (chevron) chevron.classList.toggle('open');
        }

        document.addEventListener('click', function(event) {
            var wrapper = document.querySelector('.user-menu-wrapper');
            if (wrapper && !wrapper.contains(event.target)) {
                var menu = document.getElementById('dropdownMenu');
                var chevron = document.getElementById('dropdownChevron');
                if (menu) menu.classList.remove('open');
                if (chevron) chevron.classList.remove('open');
            }
        });

        // ===== PROFILE MODAL =====
        function openProfileModal() {
            var modal = document.getElementById('profileModal');
            if (modal) {
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
                loadProfileData();
                var menu = document.getElementById('dropdownMenu');
                var chevron = document.getElementById('dropdownChevron');
                if (menu) menu.classList.remove('open');
                if (chevron) chevron.classList.remove('open');
            }
        }

        function closeProfileModal() {
            var modal = document.getElementById('profileModal');
            if (modal) {
                modal.classList.remove('active');
                document.body.style.overflow = 'auto';
            }
        }

        var profileModal = document.getElementById('profileModal');
        if (profileModal) {
            profileModal.addEventListener('click', function(e) {
                if (e.target === this) closeProfileModal();
            });
        }

        // ===== LOAD PROFILE DATA =====
        async function loadProfileData() {
            try {
                var response = await fetch('/api/user-data');
                var data = await response.json();
                if (data.error) {
                    showToast('Error loading profile: ' + data.error, 'error');
                    return;
                }
                renderProfile(data);
            } catch (error) {
                showToast('Error loading profile data', 'error');
            }
        }

        // ===== RENDER PROFILE =====
        function renderProfile(data) {
            var container = document.getElementById('profileContent');
            if (!container) return;
            
            var avatarLetter = (data.displayName || data.firstName || data.username || 'U').charAt(0).toUpperCase();
            var initials = (data.firstName ? data.firstName.charAt(0) : '') + (data.lastName ? data.lastName.charAt(0) : '');
            var completion = data.completion || 0;
            
            container.innerHTML = 
                '<div class="profile-avatar-section">' +
                    '<div class="profile-avatar">' +
                        (data.profilePhoto ? '<img src="' + data.profilePhoto + '" alt="Profile">' : (initials || avatarLetter)) +
                        '<div class="avatar-badge"><i class="fas fa-check"></i></div>' +
                    '</div>' +
                    '<div class="profile-display-name">' + (data.displayName || data.firstName || data.username || 'User') + '</div>' +
                    '<div class="profile-username">@' + (data.username || 'username') + '</div>' +
                '</div>' +
                '<div class="completion-section">' +
                    '<div class="completion-header"><span>Profile Completion</span><span>' + completion + '%</span></div>' +
                    '<div class="completion-bar"><div class="completion-fill" style="width: ' + completion + '%;"></div></div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-id-card"></i> Full Name</label>' +
                    '<div class="field-value editable" id="nameDisplay" onclick="editField(\'name\')">' + (data.firstName || '') + ' ' + (data.lastName || '') + '<span class="edit-icon"><i class="fas fa-pen"></i></span></div>' +
                    '<div class="field-value" id="nameEdit" style="display: none;">' +
                        '<input type="text" id="editFirstName" value="' + (data.firstName || '') + '" placeholder="First Name">' +
                        '<input type="text" id="editLastName" value="' + (data.lastName || '') + '" placeholder="Last Name" style="margin-top: 0.3rem;">' +
                        '<div style="display: flex; gap: 0.5rem; margin-top: 0.3rem;">' +
                            '<button class="btn btn-primary btn-sm" onclick="saveName()">Save</button>' +
                            '<button class="btn btn-secondary btn-sm" onclick="cancelEdit(\'name\')">Cancel</button>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-user"></i> Display Name</label>' +
                    '<div class="field-value editable" id="displayNameDisplay" onclick="editField(\'displayName\')">' + (data.displayName || data.firstName || data.username || 'User') + '<span class="edit-icon"><i class="fas fa-pen"></i></span></div>' +
                    '<div class="field-value" id="displayNameEdit" style="display: none;">' +
                        '<input type="text" id="editDisplayName" value="' + (data.displayName || '') + '" placeholder="Display Name">' +
                        '<div style="display: flex; gap: 0.5rem; margin-top: 0.3rem;">' +
                            '<button class="btn btn-primary btn-sm" onclick="saveDisplayName()">Save</button>' +
                            '<button class="btn btn-secondary btn-sm" onclick="cancelEdit(\'displayName\')">Cancel</button>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-at"></i> Email</label>' +
                    '<div class="field-value editable" id="emailDisplay" onclick="editField(\'email\')">' + (data.email || 'Not set') + '<span class="edit-icon"><i class="fas fa-pen"></i></span></div>' +
                    '<div class="field-value" id="emailEdit" style="display: none;">' +
                        '<input type="email" id="editEmail" value="' + (data.email || '') + '" placeholder="Enter your email">' +
                        '<div style="display: flex; gap: 0.5rem; margin-top: 0.3rem;">' +
                            '<button class="btn btn-primary btn-sm" onclick="saveEmail()">Save</button>' +
                            '<button class="btn btn-secondary btn-sm" onclick="cancelEdit(\'email\')">Cancel</button>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fab fa-telegram"></i> Telegram ID</label>' +
                    '<div class="field-value">' + (data.telegramId || 'N/A') + '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-calendar-plus"></i> Joined</label>' +
                    '<div class="field-value">' + (data.createdAt ? new Date(data.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A') + '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-clock"></i> Last Login</label>' +
                    '<div class="field-value">' + (data.lastLogin ? new Date(data.lastLogin).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'N/A') + '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-circle"></i> Account Status</label>' +
                    '<div class="field-value" style="text-transform: capitalize;">' + (data.accountStatus || 'active') + '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-link"></i> Total Links</label>' +
                    '<div class="field-value">' + (data.totalLinks || 0) + '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-mouse-pointer"></i> Total Clicks</label>' +
                    '<div class="field-value">' + (data.totalClicks || 0) + '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-globe"></i> Timezone</label>' +
                    '<div class="field-value">' + (data.timezone || 'Asia/Dhaka') + '</div>' +
                '</div>' +
                '<div class="modal-actions">' +
                    '<button class="btn btn-secondary" onclick="closeProfileModal()"><i class="fas fa-times"></i> Close</button>' +
                '</div>';
        }

        // ===== EDIT FUNCTIONS =====
        function editField(field) {
            if (field === 'name') {
                var nameDisplay = document.getElementById('nameDisplay');
                var nameEdit = document.getElementById('nameEdit');
                if (nameDisplay) nameDisplay.style.display = 'none';
                if (nameEdit) nameEdit.style.display = 'block';
            } else if (field === 'displayName') {
                var displayNameDisplay = document.getElementById('displayNameDisplay');
                var displayNameEdit = document.getElementById('displayNameEdit');
                if (displayNameDisplay) displayNameDisplay.style.display = 'none';
                if (displayNameEdit) displayNameEdit.style.display = 'block';
            } else if (field === 'email') {
                var emailDisplay = document.getElementById('emailDisplay');
                var emailEdit = document.getElementById('emailEdit');
                if (emailDisplay) emailDisplay.style.display = 'none';
                if (emailEdit) emailEdit.style.display = 'block';
            }
        }

        function cancelEdit(field) {
            if (field === 'name') {
                var nameDisplay = document.getElementById('nameDisplay');
                var nameEdit = document.getElementById('nameEdit');
                if (nameDisplay) nameDisplay.style.display = 'block';
                if (nameEdit) nameEdit.style.display = 'none';
            } else if (field === 'displayName') {
                var displayNameDisplay = document.getElementById('displayNameDisplay');
                var displayNameEdit = document.getElementById('displayNameEdit');
                if (displayNameDisplay) displayNameDisplay.style.display = 'block';
                if (displayNameEdit) displayNameEdit.style.display = 'none';
            } else if (field === 'email') {
                var emailDisplay = document.getElementById('emailDisplay');
                var emailEdit = document.getElementById('emailEdit');
                if (emailDisplay) emailDisplay.style.display = 'block';
                if (emailEdit) emailEdit.style.display = 'none';
            }
        }

        // ===== SAVE FUNCTIONS =====
        async function saveName() {
            var firstNameInput = document.getElementById('editFirstName');
            var lastNameInput = document.getElementById('editLastName');
            if (!firstNameInput || !lastNameInput) return;
            
            var firstName = firstNameInput.value.trim();
            var lastName = lastNameInput.value.trim();
            
            if (!firstName) {
                showToast('First name is required', 'error');
                return;
            }

            try {
                var response = await fetch('/api/update-profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ firstName: firstName, lastName: lastName })
                });

                var data = await response.json();
                
                if (data.success) {
                    showToast('Profile updated successfully!', 'success');
                    loadProfileData();
                    var userNameEl = document.querySelector('.user-profile-btn .user-name');
                    var avatarEl = document.querySelector('.user-profile-btn .avatar');
                    var ddNameEl = document.querySelector('.dropdown-menu .dd-name');
                    if (userNameEl) userNameEl.textContent = data.user.displayName || data.user.firstName;
                    if (avatarEl) avatarEl.textContent = data.user.displayName.charAt(0).toUpperCase();
                    if (ddNameEl) ddNameEl.textContent = data.user.displayName || data.user.firstName;
                } else {
                    showToast(data.error || 'Failed to update profile', 'error');
                }
            } catch (error) {
                showToast('Failed to update profile', 'error');
            }
        }

        async function saveDisplayName() {
            var displayNameInput = document.getElementById('editDisplayName');
            if (!displayNameInput) return;
            
            var displayName = displayNameInput.value.trim();
            
            if (!displayName) {
                showToast('Display name is required', 'error');
                return;
            }

            try {
                var response = await fetch('/api/update-profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ displayName: displayName })
                });

                var data = await response.json();
                
                if (data.success) {
                    showToast('Profile updated successfully!', 'success');
                    loadProfileData();
                    var userNameEl = document.querySelector('.user-profile-btn .user-name');
                    var avatarEl = document.querySelector('.user-profile-btn .avatar');
                    var ddNameEl = document.querySelector('.dropdown-menu .dd-name');
                    if (userNameEl) userNameEl.textContent = data.user.displayName;
                    if (avatarEl) avatarEl.textContent = data.user.displayName.charAt(0).toUpperCase();
                    if (ddNameEl) ddNameEl.textContent = data.user.displayName;
                } else {
                    showToast(data.error || 'Failed to update profile', 'error');
                }
            } catch (error) {
                showToast('Failed to update profile', 'error');
            }
        }

        async function saveEmail() {
            var emailInput = document.getElementById('editEmail');
            if (!emailInput) return;
            
            var email = emailInput.value.trim();
            
            if (!email) {
                showToast('Email is required', 'error');
                return;
            }

            var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                showToast('Please enter a valid email address', 'error');
                return;
            }

            try {
                var response = await fetch('/api/update-profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email })
                });

                var data = await response.json();
                
                if (data.success) {
                    showToast('Email updated successfully!', 'success');
                    loadProfileData();
                    var ddEmailEl = document.querySelector('.dropdown-menu .dd-email');
                    if (ddEmailEl) ddEmailEl.textContent = data.user.email || 'No email set';
                } else {
                    showToast(data.error || 'Failed to update email', 'error');
                }
            } catch (error) {
                showToast('Failed to update email', 'error');
            }
        }

        // ===== TIMEZONE =====
        async function updateTimezone() {
            var select = document.getElementById('userTimezone');
            if (!select) return;
            
            var timezone = select.value;
            if (!timezone) return;

            try {
                var response = await fetch('/api/update-timezone', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ timezone: timezone })
                });

                var data = await response.json();
                
                if (data.success) {
                    showToast('Timezone updated successfully!', 'success');
                    updateCurrentTime();
                } else {
                    showToast(data.error || 'Failed to update timezone', 'error');
                }
            } catch (error) {
                showToast('Failed to update timezone', 'error');
            }
        }

        function updateCurrentTime() {
            var select = document.getElementById('userTimezone');
            if (!select) return;
            
            var timezone = select.value || 'Asia/Dhaka';
            var display = document.getElementById('currentTimeDisplay');
            
            if (display) {
                try {
                    var now = new Date();
                    var options = {
                        timeZone: timezone,
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit',
                        hour12: true
                    };
                    display.textContent = now.toLocaleString('en-US', options);
                } catch (e) {
                    display.textContent = 'Loading time...';
                }
            }
        }

        function convertLinkDates() {
            var select = document.getElementById('userTimezone');
            if (!select) return;
            
            var timezone = select.value || 'Asia/Dhaka';
            
            document.querySelectorAll('.link-date').forEach(function(el) {
                var dateStr = el.getAttribute('data-date');
                if (dateStr) {
                    try {
                        var date = new Date(dateStr);
                        var options = {
                            timeZone: timezone,
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit'
                        };
                        el.textContent = date.toLocaleString('en-US', options);
                    } catch (e) {}
                }
            });
        }

        // ===== DOM READY =====
        document.addEventListener('DOMContentLoaded', function() {
            var select = document.getElementById('userTimezone');
            if (select) {
                var userTimezone = '<%= (typeof user !== "undefined" && user && user.timezone) ? user.timezone : "Asia/Dhaka" %>';
                if (userTimezone) select.value = userTimezone;
                updateCurrentTime();
                convertLinkDates();
                select.addEventListener('change', function() {
                    setTimeout(convertLinkDates, 500);
                });
            }
            
            document.querySelectorAll('.copy-link-btn').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    var url = this.getAttribute('data-url');
                    copyToClipboard(url);
                });
            });
            
            var form = document.getElementById('shortenForm');
            var btn = document.getElementById('shortenBtn');
            if (form && btn) {
                form.addEventListener('submit', function() {
                    var original = btn.innerHTML;
                    btn.innerHTML = '⏳ Processing...';
                    btn.disabled = true;
                    btn.style.opacity = '0.7';
                    setTimeout(function() {
                        btn.innerHTML = original;
                        btn.disabled = false;
                        btn.style.opacity = '1';
                    }, 3000);
                });
            }
            
            var ctx = document.getElementById('analyticsChart');
            if (ctx) {
                var weekData = <%= typeof weekData !== 'undefined' && weekData ? JSON.stringify(weekData) : '[0,0,0,0,0,0,0]' %>;
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                        datasets: [{
                            label: 'Clicks',
                            data: weekData,
                            borderColor: '#6C63FF',
                            backgroundColor: 'rgba(108, 99, 255, 0.08)',
                            borderWidth: 3,
                            pointBackgroundColor: '#6C63FF',
                            pointBorderColor: '#6C63FF',
                            pointBorderWidth: 2,
                            pointRadius: 5,
                            tension: 0.4,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { labels: { color: '#B0B0C8', font: { family: 'Inter', size: 12 } } }
                        },
                        scales: {
                            x: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#B0B0C8', font: { family: 'Inter', size: 11 } } },
                            y: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#B0B0C8', font: { family: 'Inter', size: 11 }, stepSize: 1 }, beginAtZero: true }
                        },
                        animation: { duration: 2000, easing: 'easeInOutQuart' }
                    }
                });
            }
        });

        setInterval(updateCurrentTime, 1000);

        // ===== TOAST =====
        function showToast(message, type, duration) {
            type = type || 'info';
            duration = duration || 3000;
            var container = document.getElementById('toastContainer');
            if (!container) return;
            
            var icons = { success: 'fas fa-check-circle', error: 'fas fa-exclamation-circle', info: 'fas fa-info-circle' };

            var toast = document.createElement('div');
            toast.className = 'toast ' + type;
            toast.innerHTML = 
                '<span class="toast-icon"><i class="' + (icons[type] || icons.info) + '"></i></span>' +
                '<span class="toast-message">' + message + '</span>' +
                '<button class="toast-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>';

            container.appendChild(toast);

            setTimeout(function() {
                toast.style.animation = 'slideOutRight 0.4s ease forwards';
                setTimeout(function() {
                    if (toast.parentElement) toast.remove();
                }, 400);
            }, duration);
        }

        // ===== COPY =====
        function copyToClipboard(text) {
            var cleanText = String(text).trim();
            if (!cleanText || cleanText === '') {
                showToast('❌ Error: Nothing to copy', 'error');
                return;
            }
            
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(cleanText).then(function() {
                    showToast('✅ Link copied to clipboard!', 'success');
                }).catch(function() {
                    fallbackCopy(cleanText);
                });
            } else {
                fallbackCopy(cleanText);
            }
        }

        function fallbackCopy(text) {
            try {
                var textarea = document.createElement('textarea');
                textarea.value = text;
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                textarea.style.width = '1px';
                textarea.style.height = '1px';
                document.body.appendChild(textarea);
                textarea.select();
                var success = document.execCommand('copy');
                document.body.removeChild(textarea);
                if (success) {
                    showToast('✅ Link copied to clipboard!', 'success');
                } else {
                    showToast('❌ Failed to copy. Please copy manually.', 'error');
                }
            } catch (err) {
                showToast('❌ Failed to copy. Please copy manually.', 'error');
            }
        }

        // ===== QR CODE =====
        async function generateQR(shortCode) {
            try {
                var response = await fetch('/qr/' + shortCode);
                var data = await response.json();
                if (data.qr) {
                    var win = window.open('', '_blank');
                    if (win) {
                        win.document.write(
                            '<html><head><title>QR Code</title></head>' +
                            '<body style="background:#0D0D1A;display:flex;justify-content:center;align-items:center;height:100vh;margin:0;font-family:Inter,sans-serif;flex-direction:column;">' +
                            '<div style="background:white;padding:20px;border-radius:12px;">' +
                            '<img src="' + data.qr + '" style="max-width:300px;width:100%;">' +
                            '</div>' +
                            '<p style="color:#B0B0C8;margin-top:20px;font-size:14px;">Scan to visit: ' + data.url + '</p>' +
                            '<button onclick="window.close()" style="margin-top:10px;padding:8px 20px;background:#6C63FF;border:none;border-radius:8px;color:white;cursor:pointer;">Close</button>' +
                            '</body></html>'
                        );
                    }
                }
            } catch (error) {
                showToast('❌ Failed to generate QR code', 'error');
            }
        }

        // ===== LIVE USER COUNT =====
        setInterval(async function() {
            try {
                var response = await fetch('/api/online-users');
                var data = await response.json();
                var countEl = document.getElementById('liveUserCount');
                if (countEl) countEl.textContent = (data.count || 0) + ' Online';
                var listEl = document.getElementById('userList');
                if (listEl && data.users) {
                    if (data.users.length > 0) {
                        var html = '';
                        for (var i = 0; i < data.users.length; i++) {
                            html += '<span class="user-badge"><span class="online-dot"></span> ' + data.users[i].name + '</span>';
                        }
                        listEl.innerHTML = html;
                    } else {
                        listEl.innerHTML = '<span style="color: var(--text-muted);">No users online</span>';
                    }
                }
            } catch (e) {}
        }, 10000);

        // ===== KEYBOARD SHORTCUTS =====
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeProfileModal();
            }
            if (e.ctrlKey && e.key === 'k') {
                e.preventDefault();
                window.location.href = '/dashboard';
            }
            if (e.ctrlKey && e.shiftKey && e.key === 'L') {
                e.preventDefault();
                var logoutForm = document.querySelector('form[action="/logout"]');
                if (logoutForm) logoutForm.submit();
            }
        });
    </script>

</body>
</html>
